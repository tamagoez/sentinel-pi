[Unit]
Description=Lockstep Sync server (Obsidian sync, reachable only over Tailscale)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sentinel
Group=sentinel
ExecStart=/usr/local/bin/lockstep-sync-server serve --data /mnt/VIDEOSD/lockstep-sync --addr 0.0.0.0:8384
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
