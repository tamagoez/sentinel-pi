[Unit]
Description=BlueALSA playback bridge (received audio -> ALSA)
Requires=sentinel-bluealsa.service
After=sentinel-bluealsa.service
# Without this, a burst of restarts (e.g. install.sh re-run without a
# reboot, bouncing bluetooth.service/sentinel-bluealsa.service under it)
# can hit systemd's default 5-in-10s limit and leave this permanently
# "failed" instead of retrying until sentinel-bluealsa.service is ready.
# Must be in [Unit], not [Service] - modern systemd silently ignores it
# there.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sleep 3
# --pcm=sysdefault:CARD=N is rewritten by install.sh with the detected
# analog output card (see CLAUDE.md's audio-mixing redesign section for
# why: a plain "default" here used to be silently hijacked by this
# project's own custom /etc/asound.conf, which no longer exists, but
# leaving this as a bare "default" would depend on alsa-lib's own
# card-selection picking the analog jack over HDMI on multi-card Pis -
# the exact ambiguity CLAUDE.md #37 exists to avoid. Being explicit here
# removes that dependency entirely, the same way music.py and voice.py
# are explicit about their own output device.
# 00:00:00:00:00:00 means "accept any paired device".
ExecStart=/usr/bin/bluealsa-aplay --pcm=sysdefault:CARD=0 00:00:00:00:00:00
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
