[Unit]
Description=Sentinel - unified camera/music/monitoring service
Documentation=file:/opt/sentinel/README.md
After=network-online.target sound.target bluetooth.service mnt-VIDEOSD.mount
Wants=network-online.target
# core/config.py resolves DATA_ROOT (and therefore where archives, captures,
# the music library and config.json all live) exactly once at import time,
# by checking whether /mnt/VIDEOSD is a directory. Without this, sentinel
# can start before the (autofs-based, noauto,x-systemd.automount) drive is
# actually mounted, silently fall back to a directory on the SD card for
# that entire run, and only pick the real external drive back up on the
# next restart - archives/captures written during the fallback run become
# invisible again afterwards, which looked like "only one archive ever
# shows up". RequiresMountsFor both orders after and actively waits for/
# triggers the mount (autofs included) before starting.
RequiresMountsFor=/mnt/VIDEOSD
# Never give up retrying, no matter how many times it crashes in a row.
# This belongs here, not in [Service]: modern systemd (v255, confirmed
# with "systemd-analyze verify") silently ignores StartLimitIntervalSec/
# StartLimitBurst under [Service] ("Unknown key name ... ignoring") -
# they are [Unit]-level rate-limit settings, not service settings, even
# though older systemd docs and examples often show them under [Service].
StartLimitIntervalSec=0

[Service]
Type=simple
User=sentinel
Group=sentinel
# video: cameras / audio: ALSA / bluetooth: BlueZ / plugdev: some USB devices
SupplementaryGroups=video audio bluetooth plugdev

WorkingDirectory=/opt/sentinel
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SENTINEL_STORAGE=/mnt/VIDEOSD
ExecStart=/opt/sentinel/.venv/bin/python -m sentinel.main

# Self-heal: restart no matter how it exits.
Restart=always
RestartSec=5

TimeoutStopSec=20
KillMode=mixed
KillSignal=SIGTERM

# --- Least privilege ---
# Never runs as root. The only root action (reboot) is granted via sudoers.
NoNewPrivileges=false
PrivateTmp=false
ProtectHome=false
ProtectSystem=false

# --- Resource caps (protect the Pi 3B+'s 1GB RAM) ---
MemoryMax=700M
MemoryHigh=600M
OOMPolicy=continue

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel

[Install]
WantedBy=multi-user.target
